{
  "name": "sudosos-back-end",
  "version": "0.1.0",
  "description": "Back-end API and database management for SudoSOS.",
  "main": "out/index.js",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --exec \"ts-node src/index.ts\"",
    "cron": "nodemon --watch \"src/**\" --ext \"ts,json\" --exec \"ts-node src/cron.ts\"",
    "serve": "node out/src/index.js",
    "schema": "ts-node src/database/schema.ts",
    "seed": "ts-node cli/seed.ts",
    "seed:dev": "ts-node cli/dev-seed.ts",
    "stripe:terminal": "ts-node cli/stripe-terminal.ts",
    "swagger": "ts-node src/start/swagger.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "swagger:validate": "ts-node src/start/swagger.ts && swagger-cli validate ./out/swagger.json",
    "test": "vitest run",
    "test-ci": "pnpm run schema && vitest run",
    "test-ci-migrate": "pnpm run migrate && vitest run",
    "test-file": "vitest run",
    "test-watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage-ci": "pnpm run schema && vitest run --coverage",
    "coverage-ci-migrate": "pnpm run migrate && vitest run --coverage",
    "schema-js": "node out/src/database/schema.js",
    "test-js": "vitest run --config vitest.config.js.mts",
    "test-js-ci": "pnpm run schema-js && cp -r test/static out/test/static && pnpm run test-js",
    "lint": "eslint package.json src test --ext .js --ext .ts",
    "lint-fix": "pnpm run lint --fix",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js",
    "predocs:dev": "typedoc",
    "typedoc": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "NODE_OPTIONS=--max-old-space-size=12288 vitepress build docs --mode production",
    "docs:preview": "vitepress preview docs",
    "maintenance": "ts-node src/maintenance.ts",
    "init:migrate": "pnpm run migrate && pnpm run seed && pnpm run maintenance",
    "init:dev": "pnpm run migrate && pnpm run seed:dev",
    "client:gen": "pnpm run swagger && cd client && npm install && npm run genbuild",
    "init:schema": "pnpm run schema && pnpm run seed && pnpm run maintenance",
    "prepare": "husky || true"
  },
  "author": "",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@gewis/pdf-compiler-ts": "1.6.0",
    "@socket.io/cluster-adapter": "0.3.0",
    "@socket.io/pm2": "5.3.0",
    "@socket.io/sticky": "1.0.4",
    "bcrypt": "5.1.1",
    "better-sqlite3": "12.11.1",
    "body-parser": "1.20.6",
    "bullmq": "5.80.7",
    "commander": "12.1.0",
    "dinero.js": "1.9.1",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-fileupload": "1.5.2",
    "express-jsdoc-swagger": "1.8.0",
    "gewisdb-ts-client": "github:GEWIS/gewisdb-ts-client#6190730be45646d58ff5968689ec22b88d2c918c",
    "gray-matter": "^4.0.3",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "ldap-escape": "2.0.6",
    "ldapts": "7.4.0",
    "log4js": "6.9.1",
    "mime-types": "2.1.35",
    "mysql2": "3.23.0",
    "node-cron": "3.0.3",
    "nodemailer": "6.10.1",
    "pdf-generator-client": "github:GEWIS/pdf-generator#31a8c6914b12e284a88f18317c1808ce8a1c0229",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "stripe": "22.3.2",
    "swagger-model-validator": "3.0.21",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.0.0",
    "uuid": "10.0.0",
    "validator": "13.15.35",
    "vitepress-theme-openapi": "0.0.3-alpha.34"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "4.0.4",
    "@braintree/sanitize-url": "7.1.2",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@swc/core": "1.15.43",
    "@types/bcrypt": "5.0.2",
    "@types/body-parser": "1.19.6",
    "@types/chai": "4.3.4",
    "@types/chai-as-promised": "7.1.4",
    "@types/chai-sorted": "0.2.3",
    "@types/deep-equal-in-any-order": "1.0.4",
    "@types/dinero.js": "1.9.4",
    "@types/express": "4.17.21",
    "@types/express-fileupload": "1.5.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mime-types": "2.1.4",
    "@types/node": "20.19.43",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "6.4.17",
    "@types/sinon": "17.0.3",
    "@types/sinon-chai": "3.2.12",
    "@types/swagger-ui-express": "4.1.8",
    "@types/uuid": "10.0.0",
    "@types/validator": "13.15.10",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "2.1.9",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "chai-http": "4.4.0",
    "chai-sorted": "0.2.0",
    "chai-swag": "0.1.9",
    "cytoscape": "3.34.0",
    "cytoscape-cose-bilkent": "4.1.0",
    "dayjs": "1.11.21",
    "debug": "4.4.3",
    "deep-equal-in-any-order": "2.2.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-plugin-chai-expect": "3.1.0",
    "eslint-plugin-chai-friendly": "1.2.1",
    "eslint-plugin-github-commit-hash": "1.1.0",
    "eslint-plugin-header": "3.1.1",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "2.4.2",
    "node-gyp": "10.3.1",
    "node-pre-gyp": "0.17.0",
    "nodemon": "3.1.14",
    "sinon": "18.0.1",
    "sinon-chai": "3.7.0",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typedoc-plugin-merge-modules": "7.0.0",
    "typedoc-vitepress-theme": "1.1.3",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.9",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "$ioredis"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "bcrypt",
      "better-sqlite3",
      "esbuild",
      "msgpackr-extract",
      "vue-demi"
    ]
  }
}
